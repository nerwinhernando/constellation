<%= turbo_frame_tag task do %>

<li class="task-row <%= "task-completed" if task.completed? %>">

  <div class="task-main">

    <span><%= task.status_icon %></span>

    <div>

      <strong><%= task.title %></strong>

      <div class="task-meta">

        <% if task.priority_icon.present? %>
          <%= task.priority_icon %>
        <% end %>

        <% if task.due_on.present? %>
          • <%= l(task.due_on) %>
        <% end %>

      </div>

    </div>

  </div>

  <div class="task-actions">

    <% if task.completed? %>
      <%= button_to "Reopen",
          reopen_workspace_plan_phase_task_path(@workspace, @plan, task.phase, task),
          method: :patch,
          class: "btn btn-secondary" %>
    <% else %>
      <%= button_to "Complete",
          complete_workspace_plan_phase_task_path(@workspace, @plan, task.phase, task),
          method: :patch,
          class: "btn btn-success" %>
    <% end %>

    <%= button_to "Edit",
        edit_workspace_plan_phase_task_path(@workspace, @plan, task.phase, task),
        method: :get,
        class: "btn btn-primary",
        form: { data: { turbo: false } } %>

    <%= button_to "Delete",
        workspace_plan_phase_task_path(@workspace, @plan, task.phase, task),
        method: :delete,
        class: "btn btn-danger",
        data: {
          turbo_confirm: "Delete this task?"
        } %>

  </div>

</li>

<% end %>
