<%= turbo_frame_tag task do %>
  <div class="task-row">

    <div class="task-info">
      <%= task.status_icon %>

      <strong><%= task.title %></strong>

      <% if task.priority_icon.present? %>
        <%= task.priority_icon %>
      <% end %>

      <% if task.overdue? %>
        <span class="text-red">Overdue</span>
      <% elsif task.due_on.present? %>
        <span><%= l(task.due_on) %></span>
      <% end %>
    </div>

    <div class="task-actions">

      <% if task.completed? %>

        <%= button_to "Reopen",
            reopen_workspace_plan_phase_task_path(
              @workspace,
              @plan,
              task.phase,
              task
            ),
            method: :patch %>

      <% else %>

        <%= button_to "Complete",
            complete_workspace_plan_phase_task_path(
              @workspace,
              @plan,
              task.phase,
              task
            ),
            method: :patch %>

      <% end %>

      <%= link_to "Edit",
          edit_workspace_plan_phase_task_path(
            @workspace,
            @plan,
            task.phase,
            task
          ),
          data: { turbo: false } %>

      <%= button_to "Delete",
          workspace_plan_phase_task_path(
            @workspace,
            @plan,
            task.phase,
            task
          ),
          method: :delete,
          data: {
            turbo_confirm: "Delete this task?"
          } %>

    </div>

  </div>
<% end %>
