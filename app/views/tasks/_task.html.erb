<div class="task-row">

  <div>

    <%= task.status_icon %>

    <%= task.title %>

    <%= task.priority_icon %>

    <% if task.overdue? %>
      🔴
    <% end %>

  </div>

  <div>

    <%= link_to "Edit",
      edit_workspace_plan_phase_task_path(
        @workspace,
        @plan,
        task.phase,
        task
      ) %>

  </div>

</div>
