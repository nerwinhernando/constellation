<%= turbo_frame_tag task do %>

<li class="task-row <%= "task-completed" if task.completed? %>">

  <div class="task-main">

    <span><%= task.status_icon %></span>

    <div>

      <strong><%= task.title %></strong>

      <div class="task-meta">

        <% if task.priority_icon.present? %>
          <%= task.priority_icon %>
        <% end %>

        <% if task.due_on.present? %>
          • <%= l(task.due_on) %>
        <% end %>

      </div>

    </div>

  </div>

  <div class="task-actions">

    <% if task.completed? %>

      <%= button_to "↩",
          reopen_workspace_plan_phase_task_path(
            @workspace,
            @plan,
            task.phase,
            task
          ),
          method: :patch,
          title: "Reopen" %>

    <% else %>

      <%= button_to "✓",
          complete_workspace_plan_phase_task_path(
            @workspace,
            @plan,
            task.phase,
            task
          ),
          method: :patch,
          title: "Complete" %>

    <% end %>

    <%= link_to "✏️",
        edit_workspace_plan_phase_task_path(
          @workspace,
          @plan,
          task.phase,
          task
        ),
        data: { turbo: false },
        title: "Edit" %>

    <%= button_to "🗑",
        workspace_plan_phase_task_path(
          @workspace,
          @plan,
          task.phase,
          task
        ),
        method: :delete,
        data: {
          turbo_confirm: "Delete task?"
        },
        title: "Delete" %>

  </div>

</li>

<% end %>
