<h1><%= @plan.title %></h1>

<p>
  <strong>Status:</strong>
  <%= @plan.status.humanize %>
</p>

<p>
  <strong>Progress:</strong>
  <%= @plan.completed_tasks %> /
  <%= @plan.total_tasks %>
  (<%= @plan.completion_percentage %>%)
</p>

<hr>

<% @phases.each do |phase| %>
  <section style="margin-bottom: 2rem;">
    <h2><%= phase.title %></h2>

    <ul>
      <% phase.tasks.each do |task| %>
        <li>
          <% if task.completed? %>
            ✅
          <% else %>
            ⬜
          <% end %>

          <strong><%= task.title %></strong>

          <% if task.priority == "critical" %>
            🔥
          <% elsif task.priority == "high" %>
            ⚠️
          <% end %>

          <% if task.due_on.present? %>
            (Due <%= l(task.due_on) %>)
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
