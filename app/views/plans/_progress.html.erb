<%= turbo_frame_tag dom_id(plan, :progress) do %>
<div class="progress-card">

  <h3>Progress</h3>

  <%= render "shared/progress_bar",
    percentage: plan.completion_percentage %>

  <p>

    <strong><%= plan.completed_tasks %></strong>
    /
    <strong><%= plan.total_tasks %></strong>

    tasks

    (<%= plan.completion_percentage %>%)

  </p>

</div>
<% end %>