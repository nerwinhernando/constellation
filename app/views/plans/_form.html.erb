<%= form_with model: [@workspace, plan] do |form| %>
  <% if plan.errors.any? %>
    <div>
      <h2>
        <%= pluralize(plan.errors.count, "error") %> prohibited this plan from being saved:
      </h2>

      <ul>
        <% plan.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %><br>
    <%= form.text_area :description, rows: 4 %>
  </div>

  <div>
    <%= form.label :status %><br>
    <%= form.select :status, Plan.statuses.keys.map { |s| [s.humanize, s] } %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
