<%= turbo_frame_tag phase do %>

<div class="phase-card">

  <header>
    <h2><%= phase.title %></h2>

    <%= link_to "Edit",
        edit_workspace_plan_phase_path(
          @workspace,
          @plan,
          phase
        ), data: { turbo: false } %>
  </header>

  <!-- Task Container -->
  <div id="<%= dom_id(phase, :tasks) %>">
    <%= render phase.tasks.ordered %>
  </div>

  <p>
    <%= link_to "Add Task",
        new_workspace_plan_phase_task_path(@workspace, @plan, phase),
        data: { turbo: false } %>
  </p>

</div>

<% end %>