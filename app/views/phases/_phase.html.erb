<%= turbo_frame_tag phase do %>

  <div class="phase-card">

    <header class="phase-header">
      <div>
        <h2><%= phase.title %></h2>
      </div>

      <div class="phase-actions">
        <%= button_to "Edit",
            edit_workspace_plan_phase_path(
              @workspace,
              @plan,
              phase
            ),
            method: :get,
            class: "btn btn-primary",
            form: { data: { turbo: false } } %>
      </div>
    </header>

    <%= render partial: "phases/progress",
               locals: { phase: phase } %>

    <div class="task-list-container">
      <ul class="task-list" id="<%= dom_id(phase, :tasks) %>">
        <%= render phase.tasks.ordered %>
      </ul>
    </div>

    <div class="phase-footer">
      <%= button_to "Add Task",
          new_workspace_plan_phase_task_path(
            @workspace,
            @plan,
            phase
          ),
          method: :get,
          class: "btn btn-success",
          form: { data: { turbo: false } } %>
    </div>

  </div>

<% end %>
