<%= turbo_frame_tag dom_id(phase, :progress) do %>

  <div class="phase-progress">

    <div class="phase-progress-header">
      <strong>Progress</strong>

      <span>
        <%= phase.completed_tasks %> /
        <%= phase.total_tasks %> tasks
        (<%= phase.completion_percentage %>%)
      </span>
    </div>

    <%= render "shared/progress_bar",
      percentage: phase.completion_percentage %>

  </div>

<% end %>
